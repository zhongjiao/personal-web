{
  "name": "pmp-management",
  "version": "1.0.0",
  "private": true,
  "description": "PMP 管理项目 - 工具集合平台 (pnpm workspace)",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently -k -n API,CUTOUT,WEB -c blue,magenta,green \"pnpm --filter @pmp/diff-api dev\" \"pnpm --filter @pmp/cutout-api dev\" \"pnpm --filter @pmp/web dev\"",
    "dev:web": "pnpm --filter @pmp/web dev",
    "dev:server": "pnpm --filter @pmp/diff-api dev",
    "dev:cutout": "pnpm --filter @pmp/cutout-api dev",
    "build": "pnpm --filter @pmp/web build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./servers/*\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,servers}/**/*.{ts,tsx,css,js,json}\"",
    "samples": "pnpm --filter @pmp/tool-diff samples",
    "clean": "pnpm -r exec rimraf node_modules && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
