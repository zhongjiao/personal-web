
# pnpm 配置
strict-peer-dependencies=false
auto-install-peers=true
# Windows 上 junction 偶发 UNKNOWN open 错误，使用 hoisted 模式（类似 npm）规避
node-linker=hoisted
# workspace 包改用「注入（复制/硬链接）」而不是符号链接：
# Windows 无开发者模式时 junction 不可用，这里彻底绕开符号链接。
# 开发态仍然读真实源码 —— 见各包 vite.config.ts 的 @pmp/* alias 与 tsconfig paths。
inject-workspace-packages=true
